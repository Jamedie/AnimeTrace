# Projet Supabase intégré à l'extension. Valeurs publiques (adresse + clé sb_publishable_),
# protégées par les règles RLS. Copier en .env.local et remplir ; ne jamais y mettre de clé secrète.
WXT_SUPABASE_URL=https://xxxx.supabase.co
WXT_SUPABASE_KEY=sb_publishable_xxxx
# Client ID MyAnimeList (public). Application de type « other » pour la connexion du compte (PKCE, sans secret).
WXT_MAL_CLIENT_ID=xxxx
